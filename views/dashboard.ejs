<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f6f3ef">
  <title><%= title %> · OULAD</title>
  <style>
    :root {
      color-scheme: light;
      --red: #a9363b;
      --red-deep: #7e292e;
      --red-soft: #f8e9e7;
      --ink: #24292f;
      --muted: #73777b;
      --line: #e7e2dc;
      --paper: #f6f3ef;
      --white: #fff;
      --gold: #c28a44;
      --slate: #687b8c;
      --sage: #789184;
    }

    * { box-sizing: border-box; }

    body {
      min-width: 320px;
      min-height: 100vh;
      margin: 0;
      background: var(--paper);
      color: var(--ink);
      font: 14px/1.5 Inter, "Segoe UI", Arial, sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    a { color: inherit; text-decoration: none; }
    button, select, input { font: inherit; }
    a:focus-visible, button:focus-visible, select:focus-visible, input:focus-visible {
      outline: 3px solid rgb(169 54 59 / 24%);
      outline-offset: 3px;
    }

    .topbar {
      height: 66px;
      border-bottom: 1px solid var(--line);
      background: rgb(255 255 255 / 84%);
    }

    .topbar-inner {
      display: flex;
      width: min(1160px, calc(100% - 56px));
      height: 100%;
      align-items: center;
      justify-content: space-between;
      margin: 0 auto;
    }

    .brand { display: flex; align-items: center; gap: 10px; }

    .brand-mark {
      position: relative;
      display: grid;
      width: 31px;
      height: 31px;
      place-items: center;
      overflow: hidden;
      border-radius: 50%;
      background: var(--red);
      color: white;
      font-family: Georgia, "Times New Roman", serif;
      font-size: 15px;
      font-weight: 700;
    }

    .brand-name { font-size: 14px; font-weight: 740; letter-spacing: .025em; }
    .brand-caption { margin-left: 2px; color: var(--muted); font-size: 11px; }
    .course-meta { color: #555d64; font-size: 12px; }
    .demo-status { display: inline-flex; align-items: center; gap: 7px; color: #607767; font-size: 10px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
    .demo-status::before { width: 7px; height: 7px; border-radius: 50%; background: currentColor; content: ""; }
    .demo-status[data-state="connecting"] { color: var(--gold); }
    .demo-status[data-state="offline"] { color: var(--red); }
    .demo-updated { margin-left: 5px; color: var(--muted); font-size: 10px; font-weight: 400; letter-spacing: 0; text-transform: none; }

    main { width: min(1160px, calc(100% - 56px)); margin: 0 auto; padding: 34px 0 56px; }

    .hero {
      position: relative;
      display: grid;
      min-height: 204px;
      grid-template-columns: minmax(0, 1fr) 220px;
      align-items: center;
      gap: 30px;
      overflow: hidden;
      padding: 30px 36px;
      border: 1px solid #e8dfd9;
      border-radius: 12px;
      background:
        radial-gradient(ellipse at 87% 45%, rgb(169 54 59 / 8%), transparent 31%),
        linear-gradient(110deg, #fff 0%, #fff 62%, #f8f2ed 100%);
    }

    .hero::before {
      position: absolute;
      inset: 0 auto 0 0;
      width: 4px;
      background: var(--red);
      content: "";
    }

    .hero-copy { position: relative; z-index: 1; }
    .course-line { display: flex; align-items: center; gap: 8px; margin-bottom: 11px; color: var(--red-deep); font-size: 10px; font-weight: 730; letter-spacing: .11em; text-transform: uppercase; }
    .course-line::before { width: 17px; height: 1px; background: var(--red); content: ""; }

    h1 {
      margin: 0;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(30px, 4vw, 42px);
      font-weight: 500;
      letter-spacing: -.045em;
      line-height: 1.08;
    }

    .hero-subtitle { max-width: 590px; margin: 10px 0 0; color: #656b70; font-size: 13px; }

    .period-illustration {
      position: relative;
      display: flex;
      min-height: 124px;
      align-items: center;
      justify-content: center;
      border-left: 1px solid #e9ddd7;
    }

    .period-ring {
      display: grid;
      width: 108px;
      height: 108px;
      place-content: center;
      border: 1px solid #dcb4ad;
      border-radius: 50%;
      background: rgb(255 255 255 / 70%);
      text-align: center;
      box-shadow: 0 0 0 9px rgb(169 54 59 / 3%), 0 0 0 19px rgb(169 54 59 / 2%);
    }

    .period-day { color: var(--red); font-family: Georgia, "Times New Roman", serif; font-size: 36px; line-height: 1; }
    .period-caption { margin-top: 5px; color: #6f6b69; font-size: 9px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }

    .period-switcher {
      display: flex;
      width: fit-content;
      gap: 3px;
      margin: 18px 0 22px;
      padding: 4px;
      border: 1px solid #e5dfd9;
      border-radius: 8px;
      background: #ece8e3;
    }

    .period-link {
      min-width: 93px;
      padding: 8px 13px;
      border-radius: 5px;
      color: #62676b;
      font-size: 11px;
      font-weight: 620;
      text-align: center;
      transition: background-color .15s ease, color .15s ease;
    }

    .period-link:hover { color: var(--red-deep); }
    .period-link[aria-current="page"] { background: white; color: var(--red-deep); box-shadow: 0 1px 3px rgb(42 35 32 / 10%); }

    .definition {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      margin: 0 0 15px;
      padding: 12px 15px;
      border: 1px solid #e7e1d9;
      border-radius: 7px;
      background: #fffdf9;
      color: #60666b;
      font-size: 11px;
    }

    .definition-mark {
      display: grid;
      width: 17px;
      height: 17px;
      flex: 0 0 auto;
      place-items: center;
      border-radius: 50%;
      background: #efe7dd;
      color: #695b4d;
      font-family: Georgia, "Times New Roman", serif;
      font-size: 11px;
      font-weight: 700;
    }

    .definition strong { color: var(--ink); }

    .metrics {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
    }

    .metric {
      position: relative;
      min-height: 115px;
      overflow: hidden;
      padding: 16px 18px 15px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: var(--white);
    }

    .metric::after {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 0;
      width: 3px;
      background: #d7d2cc;
      content: "";
    }

    .metric.alert::after { background: var(--red); }
    .metric-label { color: #676d72; font-size: 10px; font-weight: 620; }
    .metric-value { margin-top: 10px; font-size: 27px; font-weight: 670; letter-spacing: -.045em; line-height: 1; font-variant-numeric: tabular-nums; }
    .metric.alert .metric-value { color: var(--red-deep); }
    .metric-detail { margin-top: 7px; color: #85898c; font-size: 10px; }

    .section-heading {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 16px;
      margin: 29px 0 12px;
    }

    h2 { margin: 0; font-size: 15px; font-weight: 690; letter-spacing: -.02em; }
    .section-note { margin: 3px 0 0; color: var(--muted); font-size: 11px; }

    .analytics { display: grid; grid-template-columns: 1.3fr 1fr; gap: 12px; }
    .panel { min-width: 0; border: 1px solid var(--line); border-radius: 8px; background: white; }
    .panel-header { padding: 16px 18px 0; }
    .panel-title { margin: 0; font-size: 12px; font-weight: 680; }
    .panel-note { margin: 3px 0 0; color: var(--muted); font-size: 10px; }

    .activity-list { display: grid; gap: 15px; padding: 17px 18px 19px; }
    .activity-row { display: grid; grid-template-columns: 102px minmax(40px, 1fr) 42px; align-items: center; gap: 11px; }
    .activity-label, .activity-count { font-size: 10px; }
    .activity-label { color: #5e656b; }
    .activity-count { color: var(--ink); font-weight: 670; text-align: right; font-variant-numeric: tabular-nums; }
    .track { height: 8px; overflow: hidden; border-radius: 10px; background: #f0eeeb; }
    .fill { height: 100%; border-radius: inherit; background: var(--slate); }
    .activity-row:nth-child(1) .fill { background: var(--red); }
    .activity-row:nth-child(2) .fill { background: var(--gold); }
    .activity-row:nth-child(4) .fill { background: var(--sage); }

    .flag-summary { display: flex; min-height: 145px; align-items: center; gap: 20px; padding: 17px 20px; }
    .flag-number { min-width: 102px; padding-right: 19px; border-right: 1px solid var(--line); }
    .flag-number strong { display: block; color: var(--red-deep); font-family: Georgia, "Times New Roman", serif; font-size: 35px; font-weight: 500; letter-spacing: -.04em; line-height: 1; }
    .flag-number span { display: block; margin-top: 7px; color: var(--muted); font-size: 10px; }
    .flag-legend { display: grid; gap: 12px; }
    .legend-item { display: flex; align-items: center; gap: 7px; color: #515960; font-size: 10px; }
    .legend-item strong { color: var(--ink); font-size: 12px; font-weight: 680; }
    .legend-dot { width: 7px; height: 7px; flex: 0 0 auto; border-radius: 50%; background: var(--red); }
    .legend-item:last-child .legend-dot { background: #aeb9c1; }

    .table-panel { overflow: hidden; }
    .table-header { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 15px 18px; }
    .table-header h2 { font-size: 14px; }
    .table-header p { margin: 3px 0 0; color: var(--muted); font-size: 10px; }
    .search { width: min(230px, 100%); height: 35px; padding: 0 10px; border: 1px solid #dedbd6; border-radius: 5px; background: white; font-size: 11px; }
    .table-scroll { max-height: 420px; overflow: auto; }
    table { width: 100%; border-collapse: collapse; text-align: left; }
    thead { position: sticky; top: 0; z-index: 1; background: #f7f5f2; }
    th { padding: 10px 18px; color: #74797d; font-size: 9px; font-weight: 680; letter-spacing: .06em; text-transform: uppercase; }
    td { padding: 10px 18px; border-top: 1px solid #efede9; color: #4c545a; font-size: 11px; }
    tbody tr:hover { background: #fdf9f7; }
    .learner-link { color: var(--red-deep); font-weight: 670; }
    .learner-link:hover { text-decoration: underline; }
    .status { display: inline-flex; align-items: center; gap: 6px; font-size: 10px; }
    .status::before { width: 6px; height: 6px; border-radius: 50%; background: currentColor; content: ""; }
    .status.flagged { color: var(--red); }
    .status.clear { color: #607767; }
    .click-count { font-variant-numeric: tabular-nums; }
    .table-footer { padding: 11px 18px; border-top: 1px solid var(--line); color: var(--muted); font-size: 10px; }
    .empty-state { padding: 24px 18px; color: var(--muted); font-size: 12px; text-align: center; }
    .click-log { margin-top: 18px; overflow: hidden; }
    .click-log-header { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; padding: 15px 18px; border-bottom: 1px solid var(--line); }
    .click-log-header h2 { font-size: 13px; }
    .click-log-header p { margin: 0; color: var(--muted); font-size: 10px; }
    .click-log-list { display: grid; max-height: 280px; gap: 0; overflow-y: auto; margin: 0; padding: 0; list-style: none; }
    .click-log-entry { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; padding: 10px 18px; border-bottom: 1px solid #efede9; color: #4c545a; font-size: 11px; }
    .click-log-entry:last-child { border-bottom: 0; }
    .click-log-entry time { flex: 0 0 auto; color: var(--muted); font-size: 10px; font-variant-numeric: tabular-nums; }
    .click-log-empty { padding: 16px 18px; color: var(--muted); font-size: 11px; }
    .click-notification { position: fixed; right: 20px; bottom: 20px; z-index: 5; width: min(360px, calc(100vw - 40px)); padding: 14px 16px; border: 1px solid #d6e2d9; border-left: 4px solid var(--sage); border-radius: 8px; background: white; box-shadow: 0 8px 28px rgb(36 41 47 / 14%); }
    .click-notification[hidden] { display: none; }
    .click-notification-title { margin: 0; color: #607767; font-size: 10px; font-weight: 730; letter-spacing: .08em; text-transform: uppercase; }
    .click-notification-message { margin: 4px 0 0; color: var(--ink); font-size: 12px; }
    .footnote { margin: 14px 0 0; color: #85898c; font-size: 10px; }

    .back-link { display: inline-block; margin: 0 0 17px; color: var(--red-deep); font-size: 11px; font-weight: 660; }
    .profile { max-width: 680px; padding: 22px; }
    .profile h2 { font-family: Georgia, "Times New Roman", serif; font-size: 20px; font-weight: 500; }
    .profile-status { margin-top: 11px; }
    .profile-stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-top: 20px; }
    .profile-stat { padding: 15px; border: 1px solid var(--line); border-radius: 6px; background: #fbfaf8; }
    .profile-stat span { display: block; color: var(--muted); font-size: 10px; }
    .profile-stat strong { display: block; margin-top: 5px; font-size: 21px; font-weight: 680; }
    .profile-note { margin: 15px 0 0; color: var(--muted); font-size: 11px; }

    .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; clip-path: inset(50%); }
    [hidden] { display: none !important; }

    @media (max-width: 820px) {
      main, .topbar-inner { width: min(100% - 36px, 700px); }
      .hero { grid-template-columns: minmax(0, 1fr) 160px; padding-right: 22px; padding-left: 26px; }
      .metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .analytics { grid-template-columns: 1fr; }
    }

    @media (max-width: 540px) {
      .topbar { height: 58px; }
      main, .topbar-inner { width: calc(100% - 30px); }
      main { padding-top: 20px; }
      .course-meta { font-size: 10px; }
      .brand-caption { display: none; }
      .hero { min-height: 0; grid-template-columns: minmax(0, 1fr) 88px; gap: 8px; padding: 22px 15px 22px 19px; }
      .hero-subtitle { max-width: 260px; font-size: 11px; }
      .course-line { font-size: 8px; letter-spacing: .08em; }
      h1 { font-size: 29px; }
      .period-illustration { min-height: 88px; }
      .period-ring { width: 76px; height: 76px; box-shadow: 0 0 0 6px rgb(169 54 59 / 3%); }
      .period-day { font-size: 27px; }
      .period-caption { font-size: 7px; }
      .period-switcher { width: 100%; justify-content: space-between; margin: 13px 0 16px; }
      .period-link { min-width: 0; flex: 1; padding: 8px 7px; font-size: 10px; }
      .metrics { gap: 8px; }
      .metric { min-height: 103px; padding: 13px 12px 12px 15px; }
      .metric-value { font-size: 23px; }
      .metric-label, .metric-detail { font-size: 9px; }
      .section-heading { align-items: flex-start; flex-direction: column; gap: 3px; }
      .table-header { align-items: stretch; flex-direction: column; }
      .search { width: 100%; }
      th, td { padding-right: 11px; padding-left: 11px; }
      .activity-row { grid-template-columns: 88px minmax(35px, 1fr) 36px; gap: 8px; }
      .flag-summary { gap: 14px; padding-right: 12px; padding-left: 14px; }
      .flag-number { min-width: 85px; padding-right: 12px; }
    }
  </style>
</head>

<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a class="brand" href="/?week=<%= week %>">
        <span class="brand-mark" aria-hidden="true">O</span>
        <span class="brand-name">OULAD</span>
        <span class="brand-caption">Learning analytics</span>
      </a>
      <div>
        <% if (!isDetail) { %>
          <span class="demo-status" id="demo-status" data-state="connecting" role="status">Simulated live demo</span>
          <span class="demo-updated" id="demo-updated">Connecting…</span>
        <% } %>
        <span class="course-meta">Module FFF <span aria-hidden="true">·</span> 2014J</span>
      </div>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="hero-copy">
        <div class="course-line">Module FFF <span aria-hidden="true">/</span> Presentation 2014J</div>
        <h1><%= isDetail ? `Learner ${learners[0].id}` : "Learning activity" %></h1>
        <p class="hero-subtitle"><%= isDetail ? `Learner activity for week ${week}.` : "A clear view of learner activity and participation across the cohort." %></p>
      </div>
      <div class="period-illustration" aria-label="Prediction cut-off day <%= cutoffDay %>">
        <div class="period-ring">
          <span class="period-day"><%= cutoffDay %></span>
          <span class="period-caption">cut-off day</span>
        </div>
      </div>
    </section>

    <% if (!isDetail) { %>
      <nav class="period-switcher" aria-label="Prediction period">
        <% [["2", "14"], ["4", "28"], ["8", "56"]].forEach(([period, day]) => { %>
          <a class="period-link" href="/?week=<%= period %>" <% if (week === period) { %>aria-current="page"<% } %>>
            Week <%= period %> <span aria-hidden="true">·</span> Day <%= day %>
          </a>
        <% }); %>
      </nav>

      <p class="definition">
        <span class="definition-mark" aria-hidden="true">i</span>
        <span><strong>About this measure:</strong> “No clicks” means no recorded activity during the 14 days ending on the cut-off day. It is an activity indicator, not a prediction of learner ability.</span>
      </p>

      <section class="metrics" aria-label="Cohort summary">
        <article class="metric">
          <div class="metric-label">Learners</div>
          <div class="metric-value" id="live-total"><%= analytics.total.toLocaleString("en-US") %></div>
          <div class="metric-detail">In this cohort</div>
        </article>
        <article class="metric alert">
          <div class="metric-label">No clicks</div>
          <div class="metric-value" id="live-flagged"><%= analytics.flaggedCount.toLocaleString("en-US") %></div>
          <div class="metric-detail">During the 14-day window</div>
        </article>
        <article class="metric alert">
          <div class="metric-label">Share with no clicks</div>
          <div class="metric-value" id="live-rate"><%= analytics.flaggedRate.toFixed(1) %>%</div>
          <div class="metric-detail">Of all learners</div>
        </article>
        <article class="metric">
          <div class="metric-label">Average clicks</div>
          <div class="metric-value" id="live-average"><%= analytics.averageClicks.toFixed(1) %></div>
          <div class="metric-detail">Per learner</div>
        </article>
      </section>

      <section aria-labelledby="activity-heading">
        <div class="section-heading">
          <div>
            <h2 id="activity-heading">Activity distribution</h2>
            <p class="section-note">Learner count by recorded clicks in the 14-day window</p>
          </div>
        </div>

        <div class="analytics">
          <article class="panel">
            <div class="panel-header">
              <h3 class="panel-title">Clicks per learner</h3>
            </div>
            <div class="activity-list" role="img" aria-label="Learner counts by click range">
              <% analytics.activityBands.forEach(band => { %>
                <div class="activity-row" data-band="<%= band.label %>">
                  <span class="activity-label"><%= band.label %></span>
                  <span class="track"><span class="fill" style="display: block; width: <%= (band.count / analytics.maxActivityCount * 100).toFixed(1) %>%;"></span></span>
                  <span class="activity-count"><%= band.count.toLocaleString("en-US") %></span>
                </div>
              <% }); %>
            </div>
          </article>

          <article class="panel">
            <div class="panel-header">
              <h3 class="panel-title">Cohort participation</h3>
              <p class="panel-note">Learners with activity in the selected window</p>
            </div>
            <div class="flag-summary">
              <div class="flag-number">
                <strong id="live-summary-rate"><%= analytics.flaggedRate.toFixed(1) %>%</strong>
                <span>with no recorded clicks</span>
              </div>
              <div class="flag-legend">
                <div class="legend-item"><span class="legend-dot"></span><strong id="live-summary-flagged"><%= analytics.flaggedCount.toLocaleString("en-US") %></strong> no clicks</div>
                <div class="legend-item"><span class="legend-dot"></span><strong id="live-summary-active"><%= (analytics.total - analytics.flaggedCount).toLocaleString("en-US") %></strong> clicks recorded</div>
              </div>
            </div>
          </article>
        </div>
      </section>

      <section class="panel click-log" aria-labelledby="click-log-heading">
        <div class="click-log-header">
          <h2 id="click-log-heading">Simulated click log</h2>
          <p>Latest 12 events · demo only</p>
        </div>
        <ol class="click-log-list" id="click-log-list" aria-live="polite" aria-relevant="additions">
          <li class="click-log-empty" id="click-log-empty">Waiting for simulated click activity…</li>
        </ol>
      </section>

      <section id="learners" aria-labelledby="learners-heading">
        <div class="section-heading">
          <div>
            <h2 id="learners-heading">Learner records</h2>
            <p class="section-note">Learners with no clicks appear first.</p>
          </div>
        </div>

        <div class="panel table-panel">
          <div class="table-header">
            <div>
              <h2>Learner activity</h2>
              <p>Search by learner ID or activity status.</p>
            </div>
            <label>
              <span class="visually-hidden">Search learners</span>
              <input class="search" id="learner-search" type="search" placeholder="Search learner records…" autocomplete="off">
            </label>
          </div>
          <div class="table-scroll" tabindex="0" aria-label="Scrollable learner records">
            <table>
              <thead>
                <tr>
                  <th scope="col">Learner ID</th>
                  <th scope="col">Activity status</th>
                  <th scope="col">Clicks</th>
                  <th scope="col"><span class="visually-hidden">Details</span></th>
                </tr>
              </thead>
              <tbody id="learner-rows">
                <% learners.forEach(learner => { %>
                  <tr data-learner-id="<%= learner.id %>" data-search="<%= `${learner.id} ${learner.risk === 1 ? "no clicks" : "clicks recorded"}`.toLowerCase() %>">
                    <td><a class="learner-link" href="/learners/<%= encodeURIComponent(learner.id) %>?week=<%= week %>"><%= learner.id %></a></td>
                    <td><span class="status <%= learner.risk === 1 ? "flagged" : "clear" %>"><%= learner.risk === 1 ? "No clicks" : "Clicks recorded" %></span></td>
                    <td class="click-count"><%= learner.clicks.toLocaleString("en-US") %></td>
                    <td><a class="learner-link" href="/learners/<%= encodeURIComponent(learner.id) %>?week=<%= week %>">View record</a></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
            <div class="empty-state" id="empty-state" hidden>No matching learners.</div>
          </div>
          <div class="table-footer" id="result-count"><%= analytics.total.toLocaleString("en-US") %> learners</div>
        </div>
      </section>
      <p class="footnote">Historical OULAD sample data with simulated live updates; this demo is not connected to Google Classroom.</p>
    <% } else { %>
      <% const learner = learners[0]; %>
      <a class="back-link" href="/?week=<%= week %>">← All learners</a>
      <section class="panel profile" aria-label="Learner activity">
        <h2>Activity summary</h2>
        <span class="status profile-status <%= learner.risk === 1 ? "flagged" : "clear" %>">
          <%= learner.risk === 1 ? "No clicks recorded" : "Clicks recorded" %>
        </span>
        <div class="profile-stats">
          <div class="profile-stat">
            <span>Recorded clicks</span>
            <strong><%= learner.clicks.toLocaleString("en-US") %></strong>
          </div>
          <div class="profile-stat">
            <span>Prediction period</span>
            <strong>Week <%= week %></strong>
          </div>
        </div>
        <p class="profile-note">No clicks is an activity indicator only; it does not determine a learner’s ability or outcome.</p>
      </section>
    <% } %>
  </main>
  <% if (!isDetail) { %>
    <aside class="click-notification" id="click-notification" role="status" aria-live="polite" aria-atomic="true" hidden>
      <p class="click-notification-title">New simulated click activity</p>
      <p class="click-notification-message" id="click-notification-message"></p>
    </aside>
  <% } %>

  <script>
    const searchInput = document.getElementById("learner-search");
    if (searchInput) {
      const rows = Array.from(document.querySelectorAll("#learner-rows tr"));
      const emptyState = document.getElementById("empty-state");
      const resultCount = document.getElementById("result-count");
      const query = () => searchInput.value.trim().toLowerCase();

      const filterRows = () => {
        const searchTerm = query();
        let visibleCount = 0;

        rows.forEach(row => {
          const matches = row.dataset.search.includes(searchTerm);
          row.hidden = !matches;
          if (matches) visibleCount += 1;
        });

        emptyState.hidden = visibleCount > 0;
        resultCount.textContent = `${visibleCount.toLocaleString("en-US")} ${visibleCount === 1 ? "learner" : "learners"}`;
      };

      searchInput.addEventListener("input", filterRows);

      const liveStatus = document.getElementById("demo-status");
      const liveUpdated = document.getElementById("demo-updated");
      const clickLog = document.getElementById("click-log-list");
      const clickLogEmpty = document.getElementById("click-log-empty");
      const clickNotification = document.getElementById("click-notification");
      const clickNotificationMessage = document.getElementById("click-notification-message");
      const numberFormat = new Intl.NumberFormat("en-US");
      const stream = new EventSource(`/api/demo/stream?week=<%= week %>`);
      let notificationTimeout;

      stream.onopen = () => {
        liveStatus.dataset.state = "live";
        liveStatus.textContent = "Simulated live demo";
      };
      stream.onerror = () => {
        liveStatus.dataset.state = "offline";
        liveStatus.textContent = "Reconnecting";
        liveUpdated.textContent = "";
      };
      stream.onmessage = event => {
        const update = JSON.parse(event.data);
        const learner = update.learner;
        const row = document.querySelector(`[data-learner-id="${learner.id}"]`);
        if (row) {
          const isFlagged = learner.risk === 1;
          row.dataset.search = `${learner.id} ${isFlagged ? "no clicks" : "clicks recorded"}`.toLowerCase();
          const status = row.querySelector(".status");
          status.className = `status ${isFlagged ? "flagged" : "clear"}`;
          status.textContent = isFlagged ? "No clicks" : "Clicks recorded";
          row.querySelector(".click-count").textContent = numberFormat.format(learner.clicks);
          filterRows();
        }

        const analytics = update.analytics;
        document.getElementById("live-total").textContent = numberFormat.format(analytics.total);
        document.getElementById("live-flagged").textContent = numberFormat.format(analytics.flaggedCount);
        document.getElementById("live-rate").textContent = `${analytics.flaggedRate.toFixed(1)}%`;
        document.getElementById("live-average").textContent = analytics.averageClicks.toFixed(1);
        document.getElementById("live-summary-rate").textContent = `${analytics.flaggedRate.toFixed(1)}%`;
        document.getElementById("live-summary-flagged").textContent = numberFormat.format(analytics.flaggedCount);
        document.getElementById("live-summary-active").textContent = numberFormat.format(analytics.total - analytics.flaggedCount);

        analytics.activityBands.forEach(band => {
          const row = document.querySelector(`[data-band="${band.label}"]`);
          row.querySelector(".activity-count").textContent = numberFormat.format(band.count);
          row.querySelector(".fill").style.width = `${(band.count / analytics.maxActivityCount * 100).toFixed(1)}%`;
        });

        if (update.clickEvent) {
          clickLogEmpty.hidden = true;
          const entry = document.createElement("li");
          entry.className = "click-log-entry";
          const message = document.createElement("span");
          const activityMessage = `Learner ${update.clickEvent.learnerId} recorded +${numberFormat.format(update.clickEvent.clicksAdded)} simulated clicks (total: ${numberFormat.format(update.clickEvent.totalClicks)})`;
          message.textContent = activityMessage;
          const time = document.createElement("time");
          time.dateTime = update.clickEvent.occurredAt;
          time.textContent = new Date(update.clickEvent.occurredAt).toLocaleTimeString();
          entry.append(message, time);
          clickLog.insertBefore(entry, clickLog.firstChild);
          while (clickLog.children.length > 12) {
            clickLog.removeChild(clickLog.lastElementChild);
          }

          clickNotificationMessage.textContent = activityMessage;
          clickNotification.hidden = false;
          clearTimeout(notificationTimeout);
          notificationTimeout = setTimeout(() => {
            clickNotification.hidden = true;
          }, 2200);
        }

        liveStatus.dataset.state = "live";
        liveUpdated.textContent = `Updated ${new Date(update.updatedAt).toLocaleTimeString()}`;
      };
    }
  </script>
</body>
</html>
